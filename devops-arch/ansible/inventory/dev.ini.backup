[master]
master ansible_host=192.168.56.10 ansible_user=vagrant ansible_ssh_private_key_file=vagrant/.vagrant/machines/master/virtualbox/private_key

[workers]
worker1 ansible_host=192.168.56.11 ansible_user=vagrant ansible_ssh_private_key_file=vagrant/.vagrant/machines/worker1/virtualbox/private_key
worker2 ansible_host=192.168.56.12 ansible_user=vagrant ansible_ssh_private_key_file=vagrant/.vagrant/machines/worker2/virtualbox/private_key

[kubernetes:children]
master
workers

[all:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
