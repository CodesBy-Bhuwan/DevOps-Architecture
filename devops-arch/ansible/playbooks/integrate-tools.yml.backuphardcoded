---
# Play 1: Talk to Jenkins (but delegate the Nexus password fetch)
- name: Integrate Jenkins with Nexus
  hosts: control-node
  become: yes
  tasks:
    # We run this command, but Ansible SSHes into the Nexus server to do it!
    - name: Fetch Nexus Password (Delegated to Nexus)
      ansible.builtin.command: docker exec nexus cat /nexus-data/admin.password
      register: nexus_admin_password
      delegate_to: monitoring-node
      changed_when: false

    - name: Ensure Docker Repository exists in Nexus (Delegated to Nexus)
      uri:
        url: "http://{{ hostvars['monitoring-node']['ansible_host'] }}:8081/service/rest/v1/repositories/docker/hosted"
        method: POST
        user: "admin"
        password: "{{ nexus_admin_password.stdout }}"
        body_format: json
        headers:
          Content-Type: "application/json"
        body: |
          {
            "name": "docker-hosted",
            "online": true,
            "storage": {
              "blobStoreName": "default",
              "strictContentTypeValidation": false
            },
            "docker": {
              "v1Enabled": false,
              "forceBasicAuth": true,
              "httpPort": 8082
            }
          }
        status_code: [201, 400]
      delegate_to: monitoring-node
      changed_when: false

    # Now we are back on the Jenkins host. The variable is perfectly in memory!
    - name: Render JCasC configuration with dynamic password
      ansible.builtin.template:
        src: ../roles/jenkins/templates/jenkins.yml.j2
        dest: /opt/jenkins/casc/jenkins.yml

    - name: Restart Jenkins to apply JCasC
      ansible.builtin.command: docker restart jenkins
      changed_when: false

    - name: Wait for Jenkins to be ready
      ansible.builtin.uri:
        url: "http://{{ ansible_host }}:8080/login"
        status_code: [200, 403]
      register: result
      until: result.status in [200, 403]
      retries: 60
      delay: 5
