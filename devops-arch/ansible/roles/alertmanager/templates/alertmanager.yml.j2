global:
  smtp_smarthost: "{{ smtp_host }}:{{ smtp_port }}"
  smtp_from: "{{ smtp_auth_username }}"
  smtp_auth_username: "{{ smtp_auth_username }}"
  smtp_auth_password: "{{ smtp_auth_password }}"
  smtp_require_tls: true
  smtp_hello: "localhost"

route:
  group_by: ['alertname', 'cluster']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'email'
  routes:
    - match:
        severity: 'critical'
      receiver: 'email'
      continue: true
    - match:
        severity: 'warning'
      receiver: 'email'
      continue: true

receivers:
  - name: 'email'
    email_configs:
      - to: '{{ alert_receiver_email }}'
        send_resolved: true
        headers:
          Subject: '{{ "{{ .GroupLabels.alertname }}" }} - AlertManager Notification'
