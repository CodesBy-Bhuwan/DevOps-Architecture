server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yaml

clients:
  - url: http://{{ hostvars[groups['monitoring_ops'][0]].ansible_host }}:3100/loki/api/v1/push

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 15s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'container'
      - source_labels: ['__meta_docker_container_image']
        target_label: 'image'
      - source_labels: ['__meta_docker_container_id']
        target_label: 'container_id'

  - job_name: system
    static_configs:
      - targets: ['localhost']
        labels:
          job: syslog
          host: {{ ansible_host }}
          __path__: /var/log/syslog

  - job_name: auth
    static_configs:
      - targets: ['localhost']
        labels:
          job: auth
          host: {{ ansible_host }}
          __path__: /var/log/auth.log
