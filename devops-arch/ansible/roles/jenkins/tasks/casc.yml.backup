---
- name: Copy JCasC configuration to host
  ansible.builtin.copy:
    src: casc/
    dest: /opt/jenkins/casc/

- name: Restart Jenkins to apply JCasC
  ansible.builtin.command: docker restart jenkins
  changed_when: false

- name: Wait for Jenkins to be ready
  ansible.builtin.uri:
    url: "http://{{ ansible_host }}:8080/login"
    status_code: [200, 403]
  register: result
  until: result.status in [200, 403]
  retries: 60
  delay: 5
