# ------------------------------------------------------------

build/
dist/
out/
output/

*.bin
*.iso
*.img


# ------------------------------------------------------------
# Database / Local Development
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db

data/
local-data/


# ------------------------------------------------------------
# Application Logs
# ------------------------------------------------------------

*.log
logs/

# Keep important example logs if needed
!logs/example/


# ------------------------------------------------------------
# Generated Documentation
# ------------------------------------------------------------

docs/generated/
site/
public/


# ------------------------------------------------------------
# Local Infrastructure State
# ------------------------------------------------------------

state/
.local/
.local-state/
.runtime/
runtime/

*.state
*.state.json


# ------------------------------------------------------------
# Backup Files
# ------------------------------------------------------------

backup/
backups/

*.backup
*.bak
*.old
*.orig


# ------------------------------------------------------------
# Local Overrides
# ------------------------------------------------------------

# Local-only infrastructure configuration
*.local
*.local.yml
*.local.yaml
*.local.json
*.local.conf
*.local.cfg

# Explicitly allow committed examples
!*.local.example
!*.local.sample


# ------------------------------------------------------------
# Credentials accidentally generated by tools
# ------------------------------------------------------------

credentials.json
credentials.yml
credentials.yaml
service-account.json
serviceaccount.json

# Cloud provider credentials
gcp-credentials.json
azure-credentials.json
aws-credentials.json


# ------------------------------------------------------------
# JWT / Tokens
# ------------------------------------------------------------

*.token
*.tokens
*.jwt

token/
tokens/


# ------------------------------------------------------------
# Terraform / OpenTofu Additional Files
# ------------------------------------------------------------

.terraform.lock.hcl

# NOTE:
# The Terraform lock file is normally committed.
# If using Terraform/OpenTofu, REMOVE the line above if you
# want dependency locking to be tracked.
# The recommended approach is to COMMIT this file.


# ------------------------------------------------------------
# Pulumi
# ------------------------------------------------------------

.pulumi/
Pulumi.*.yaml

# Keep non-secret project configuration if appropriate
!Pulumi.yaml


# ------------------------------------------------------------
# Server Provisioning Output
# ------------------------------------------------------------

provisioning-output/
provision-output/
setup-output/
install-output/

*.provision.log
*.install.log
*.setup.log


# ------------------------------------------------------------
# Local AWS / EC2 Generated Data
# ------------------------------------------------------------

ec2-output/
ec2-state/
ec2-instances/
instance-data/

# Generated public/private IP lists
public-ips.txt
private-ips.txt
instance-ips.txt
instance-ids.txt


# ------------------------------------------------------------
# Vagrant Generated Data
# ------------------------------------------------------------

vagrant-output/
vagrant-state/

# Vagrant generated host information
vagrant-hosts
vagrant-hosts.txt
vagrant-inventory


# ------------------------------------------------------------
# Miscellaneous Generated Files
# ------------------------------------------------------------

*.generated
*.generated.json
*.generated.conf

generated/
generated-files/

# Runtime files
run/
runtime/
*.run

# PID / socket files
*.sock
*.socket


# ------------------------------------------------------------
# Preserve Infrastructure Source Files
# ------------------------------------------------------------

# The following are intentionally NOT ignored:
#
# *.sh
# *.bash
# *.yml
# *.yaml
# Vagrantfile
# *.tf
# *.tfvars.example
# ansible/
# playbooks/
# roles/
# scripts/
#
# These files contain the actual infrastructure definitions
# and should normally be committed to Git.


# ------------------------------------------------------------
# Explicit Infrastructure Files That Should Be Tracked
# ------------------------------------------------------------

!Vagrantfile
!*.sh
!*.bash
!*.yml
!*.yaml

# Common infrastructure directories
# !scripts/
# !scripts/**
# !provision/
# !provision/**
# !ansible/
# !ansible/**
# !playbooks/
# !playbooks/**
# !roles/
# !roles/**

# Terraform source
!*.tf

# Terraform lock file should be tracked
!.terraform.lock.hcl