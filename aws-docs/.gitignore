# ------------------------------------------------------------

*.pem
*.key
*.csr
*.crt
*.cer
*.der
*.p7b
*.p7c
*.p12
*.pfx
*.jks
*.keystore

# Certificate directories
certs/
certificates/
ssl/
tls/

# Allow public/example certificates if desired
